# StoreLaunch Funnel — duplicate backend configuration
# Create your own values in Vercel. Never commit a real .env file.

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
ORDERS_DATABASE_ID=your_orders_database_id
ORDERS_COLLECTION_ID=your_orders_collection_id
SIGNUPS_DATABASE_ID=your_signups_database_id
SIGNUPS_COLLECTION_ID=your_signups_collection_id
# Only needed when using the Appwrite-stored Zoho token fallback. With
# ZOHO_REFRESH_TOKEN configured, this collection is not required at runtime.
ZOHO_TOKENS_DATABASE_ID=your_store_database_id
ZOHO_TOKENS_COLLECTION_ID=your_zoho_tokens_collection_id

PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_CALLBACK_URL=https://your-domain.com/api/paystack-callback
FRONTEND_BASE_URL=https://your-domain.com
BACKEND_BASE_URL=https://your-domain.com

ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=https://your-domain.com/zoho/callback
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Zoho list routing — replace with your own Campaigns list keys.
# Use separate lists for DIY buyers and DFY requests. If either is left blank in your live environment, the backend falls back to MAIN_LIST_KEY.
MAIN_LIST_KEY=your_main_list_key
DIY_LIST_KEY=your_storelaunch_diy_list_key
DFY_LIST_KEY=your_storelaunch_dfy_list_key
BOUGHT_CORE_OFFER_ONLY_LIST_KEY=your_core_only_list_key
BOUGHT_VSL_COURSE_ONLY_LIST_KEY=your_vsl_only_list_key
BOUGHT_OFFERS_COURSE_ONLY_LIST_KEY=your_offers_only_list_key
BOUGHT_YOUTUBE_ADS_ONLY_LIST_KEY=your_youtube_only_list_key
BOUGHT_VSL_AND_OFFERS_LIST_KEY=your_vsl_and_offers_list_key
BOUGHT_VSL_AND_YOUTUBE_LIST_KEY=your_vsl_and_youtube_list_key
BOUGHT_OFFERS_AND_YOUTUBE_LIST_KEY=your_offers_and_youtube_list_key
BOUGHT_ALL_UPSELLS_LIST_KEY=your_all_upsells_list_key

OFFER_WINDOW_MINUTES=30
ZOHO_DAILY_QUOTA=1000
# Meta Pixel and Conversions API
META_PIXEL_ID=your_meta_pixel_id
META_CONVERSIONS_API_ACCESS_TOKEN=your_meta_conversions_api_access_token
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v24.0
GA_MEASUREMENT_ID=
GOOGLE_ADS_ID=
